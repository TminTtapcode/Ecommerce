# =====================================================
# Enterprise Ecommerce — Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.
#
# For IntelliJ IDEA:
#   Run → Edit Configurations → Environment variables
#   Paste all key=value pairs (semicolon-separated)
#
# For terminal/CLI:
#   export DB_PASSWORD=your_password  (Linux/macOS)
#   set DB_PASSWORD=your_password     (Windows CMD)
#   $env:DB_PASSWORD="your_password"  (PowerShell)
# =====================================================

# --- Database ---
DB_PASSWORD=your_mysql_password

# --- Mail (Gmail App Password) ---
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# --- JWT ---
JWT_SECRET_KEY=your_hex_encoded_256bit_secret_key

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- VNPay ---
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_SECRET_KEY=your_vnpay_secret_key
